<?xml version="1.0" encoding="utf-8"?>
<!-- Logical 320x266 dp, physically 160x128 px on a 2-inch panel: every dp is
     half a real pixel, so text is sized roughly twice what a phone would use.
     Three generic rows (row3 only used by the menu) and a status/text area. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="2dp">

    <include layout="@layout/row" android:id="@+id/row1"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <include layout="@layout/row" android:id="@+id/row2"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <include layout="@layout/row" android:id="@+id/row3"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:textColor="#CFD8DC"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>

    <!-- Exit confirmation shown when Home is pressed inside a running app. -->
    <LinearLayout
        android:id="@+id/confirm_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#101820"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#263238"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/confirm_title"
            android:textColor="#CFD8DC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/confirm_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="10dp"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/confirm_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/confirm_body"
                android:textColor="#B0BEC5"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="#C62828"
                android:gravity="center"
                android:text="@string/confirm_ok"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#455A64"
                android:gravity="center"
                android:text="@string/confirm_back"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
