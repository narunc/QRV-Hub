<?xml version="1.0" encoding="utf-8"?>
<!-- Volume slider, shown in a system overlay window across the top of the screen so it
     covers the firmware's own volume popup (which the system draws in that strip). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:id="@+id/volume_bar" android:layout_width="match_parent" android:layout_height="40dp"
        android:layout_gravity="center_vertical" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/card" android:paddingLeft="8dp" android:paddingRight="10dp">
        <ImageView android:id="@+id/volume_icon" android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_speaker" android:contentDescription="@null" />
        <FrameLayout android:id="@+id/volume_track" android:layout_width="0dp" android:layout_height="10dp"
            android:layout_weight="1" android:layout_marginLeft="8dp" android:layout_marginRight="8dp"
            android:background="@drawable/vol_track">
            <View android:id="@+id/volume_fill" android:layout_width="0dp" android:layout_height="match_parent"
                android:background="@drawable/vol_fill" />
        </FrameLayout>
        <TextView android:id="@+id/volume_value" android:layout_width="26dp" android:layout_height="wrap_content"
            android:gravity="right" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
